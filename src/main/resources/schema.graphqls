type Option {
    codeOption: Int!
    libelle: String
    domaine: String
    responsable: String
    credits: Int
    semestre: Int
    capacite: Int
}

type Etudiant {
    identifiant: String!
    nom: String
    prenom: String
    anneeEtude: Int
    email: String
    option: Option
}

type Query {
    # Section A - Options
    getAllOptions: [Option]
    getOptionsByDomaine(domaine: String!): [Option]
    getOptionByCode(codeOption: Int!): Option

    # Section B - Etudiants
    getEtudiantByIdentifiant(identifiant: String!): Etudiant
    getEtudiantsByOption(codeOption: Int!): [Etudiant]
}

type Mutation {
    # Section A - Options
    addOption(
        codeOption: Int!,
        libelle: String!,
        domaine: String!,
        responsable: String!,
        credits: Int!,
        semestre: Int!,
        capacite: Int!
    ): Boolean

    updateOption(
        codeOption: Int!,
        libelle: String!,
        domaine: String!,
        responsable: String!,
        credits: Int!,
        semestre: Int!,
        capacite: Int!
    ): Boolean

    deleteOption(codeOption: Int!): Boolean

    # Section B - Etudiants
    addEtudiant(
        identifiant: String!,
        nom: String!,
        prenom: String!,
        anneeEtude: Int!,
        email: String!,
        codeOption: Int!
    ): Boolean

    updateEtudiant(
        identifiant: String!,
        nom: String!,
        prenom: String!,
        anneeEtude: Int!,
        email: String!,
        codeOption: Int!
    ): Boolean

    deleteEtudiant(identifiant: String!): Boolean
}